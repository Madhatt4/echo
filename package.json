{
  "name": "echo",
  "version": "0.3.0",
  "private": true,
  "description": "Capture yourself while you are alive, so your family can keep talking to an AI echo of you.",
  "main": "dist/main/main.js",
  "scripts": {
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json && tsc -p tsconfig.tests.json",
    "test": "node --test \"tests/**/*.test.ts\"",
    "build": "tsc -p tsconfig.main.json && vite build",
    "start": "npm run build && electron .",
    "smoke": "npm run build && electron . --smoke",
    "dist": "npm run build && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.0",
    "electron-builder": "^26.8.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.7"
  },
  "engines": {
    "node": ">=22.18"
  },
  "author": "Marc Hatton",
  "license": "AGPL-3.0-only",
  "build": {
    "appId": "io.github.madhatt4.echo",
    "productName": "Echo",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Echo",
      "artifactName": "Echo-Setup-${version}.${ext}",
      "deleteAppDataOnUninstall": false
    },
    "extraFiles": [
      {
        "from": "build/echo-door.cmd",
        "to": "echo-door.cmd"
      }
    ]
  }
}
